---
import { Code } from "@astrojs/starlight/components";

import ReferencePage from "../components/reference-page.astro";
import { REFERENCE, siteHref } from "../lib/reference";
---

<ReferencePage title="Development">
  <Code code={REFERENCE.development} lang="sh" />
  <p><code>pnpm docs:generate</code> rebuilds package documentation. <code>pnpm site:build</code> builds this site from declarations, schemas and examples. <code>pnpm verify</code> checks both.</p>
  <p><a href={`${REFERENCE.repository}/blob/main/package.json`}>Package commands</a> · <a href={`${REFERENCE.repository}/blob/main/LICENSE`}>MIT license</a> · <a href={siteHref("Nunito-Variable-OFL-1.1.txt")}>Site font license</a> · <a href={siteHref("Nunito-OFL-1.1.txt")}>Chart font license</a></p>
</ReferencePage>
