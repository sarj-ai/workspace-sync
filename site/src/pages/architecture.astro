---
import "@xyflow/react/dist/style.css";

import { Code } from "@astrojs/starlight/components";

import ArchitectureFlow from "../components/architecture-flow";
import ReferencePage from "../components/reference-page.astro";
import { architecture, architectureMermaid } from "../lib/architecture";
import { siteHref } from "../lib/reference";
---

<ReferencePage title="Architecture">
  <p class="command-help">Google Workspace supplies the people and teams. Each provider compares its current state, prepares changes and applies the approved result.</p>
  <ArchitectureFlow client:visible />
  <p class="command-help">Pan or zoom to explore. Your application owns approval.</p>
  <details>
    <summary>Data flow and source</summary>
    <ol>{architecture.nodes.map((node) => <li><a href={siteHref(`api/${node.module}/`)}>{node.label}</a> — {node.detail}.</li>)}</ol>
  </details>
  <h2>Plan, review, apply</h2>
  <p>Preview changes first. Applying checks that the data still matches the plan, makes the change, and reads the result back. If the data changed, review a new plan.</p>
  <p><a href={siteHref("plan-and-apply/")}>SlackProfileSync</a> updates one profile per apply. Other integrations expose their own modules above. <a href={siteHref("storage/")}>Storage</a> is optional for basic profile sync.</p>
  <details>
    <summary>Mermaid source (11.3+)</summary>
    <Code code={architectureMermaid()} lang="text" />
  </details>
  <p><a href={siteHref("architecture.mmd")} download>Download Mermaid</a></p>
</ReferencePage>
