---
import "@xyflow/react/dist/style.css";

import { Code } from "@astrojs/starlight/components";

import ArchitectureFlow from "../components/architecture-flow";
import ReferencePage from "../components/reference-page.astro";
import { architectureMermaid, integrations, apiHref } from "../lib/architecture";
import { siteHref } from "../lib/reference";
---

<ReferencePage title="Architecture" wide>
  <p class="command-help">Google Workspace supplies identity authority. Your application owns credentials, policy and approval. Explore how each integration uses them.</p>
  <ArchitectureFlow client:load />
  <noscript><p>Enable JavaScript to explore the diagram. The workflow summary and API links below work without it.</p></noscript>
  <details>
    <summary>All integrations and API references</summary>
    <ul>{integrations.map((provider) => <li><a href={apiHref(provider.module)}>{provider.label}</a> — {provider.scope} {provider.guard}</li>)}</ul>
  </details>
  <p class="command-help"><a href={siteHref("plan-and-apply/")}>Try a Slack plan/apply example</a> · <a href={siteHref("storage/")}>When a workflow needs storage</a></p>
  <details>
    <summary>Mermaid source (11.3+)</summary>
    <Code code={architectureMermaid()} lang="text" />
  </details>
  <p><a href={siteHref("architecture.mmd")} download>Download Mermaid</a></p>
</ReferencePage>
