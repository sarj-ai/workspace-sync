---
import { Code, LinkCard, CardGrid } from "@astrojs/starlight/components";

import ReferencePage from "../components/reference-page.astro";
import { REFERENCE, siteHref } from "../lib/reference";
---

<ReferencePage title="Workspace Sync">
  <p class="command-help">{REFERENCE.description}.</p>
  <CardGrid>
    <LinkCard title="Architecture" description="Follow the data." href={siteHref("architecture/")} />
    <LinkCard title="Plan / apply" description="Preview, review, execute." href={siteHref("plan-and-apply/")} />
    <LinkCard title="Configuration" description="Start with a read-only audit." href={siteHref("configuration/")} />
    <LinkCard title="API" description="Typed module reference." href={siteHref("api/")} />
  </CardGrid>
  <h2>Install</h2>
  <Code code={REFERENCE.install} lang="sh" />
  <p class="command-help">Node.js {REFERENCE.node} · v{REFERENCE.version} · <a href={siteHref("security/")}>Security</a></p>
</ReferencePage>
